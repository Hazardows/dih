func test(name) {
    println("Hi from ", name);
    return "XD ";
}

func main() {
    // loop tests
    var a = 0, temp = 0;
    for (var b = 1; a < 1000000; b += temp) {
        temp = a ** (1 / 2);
        println(a, " ", b, " ", temp);
        a = b / 2;
    }
    
    func nigga(x, i) {
        var xd = "";
        if (i < 5) {
            for (var j = 0; j < i; j++) {
                print("\t");
            }
            xd += test(x) + nigga(x, i + 1);
            for (var j = 0; j < i; j++) {
                print("\t");
            }
            xd += test(x);
        }
        return xd;
    }
    println(nigga("dih", 0));
}

main();

func fib(n) {
    if (n <= 1) return n;
    return fib(n - 2) + fib(n - 1);
}

for (var i = 1; i <= 20; i++) {
    println("fib of ", i, " ", fib(i));
}